<?php
use Drupal\node\Entity\Node;
use Drupal\user\Entity\User;

/**
 * Implements hook_cron().
 */
function delete_node_cron() {
  $six_months_ago = strtotime('-6 months');

  // ID of old news.
  $nids = \Drupal::entityQuery('node')
    ->condition('type', 'news')
    ->condition('created', $six_months_ago, '<')
    ->execute();

  if (!empty($nids)) {
    $nodes = Node::loadMultiple($nids);

    // Collecting deleted news.
    $deleted_titles = [];
    foreach ($nodes as $node) {
      $deleted_titles[] = $node->getTitle();
      $node->delete();
    }

    // Send email to all editors.
    if (!empty($deleted_titles)) {
      delete_node_send_email_to_editors($deleted_titles);
    }
  }
}

/**
 * Sending email to all editors about deleted news.
 */
function delete_node_send_email_to_editors(array $deleted_titles) {
  $mailManager = \Drupal::service('plugin.manager.mail');
  $module = 'delete_node';
  $key = 'news_deleted';
  $langcode = \Drupal::languageManager()->getDefaultLanguage()->getId();

  // Get all users with editor role.
  $uids = \Drupal::entityQuery('user')
    ->condition('status', 1)
    ->condition('roles', 'editor')
    ->execute();

  $users = User::loadMultiple($uids);
  $deleted_list = "- " . implode("\n- ", $deleted_titles);

  foreach ($users as $user) {
    $to = $user->getEmail();
    $params['subject'] = 'News Deleted Notification';
    $params['message'] = "The following News older than 6 months were deleted:\n" . $deleted_list;

    $mailManager->mail($module, $key, $to, $langcode, $params, NULL, TRUE);
  }
}

/**
 * Implements hook_mail().
 */
function delete_node_mail($key, &$message, $params) {
  switch ($key) {
    case 'news_deleted':
      $message['subject'] = $params['subject'];
      $message['body'][] = $params['message'];
      break;
  }
}
